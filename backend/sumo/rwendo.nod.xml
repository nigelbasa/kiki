<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rwendo SUMO node topology — 4-junction rectangle network.
  Coordinate system: SUMO y grows southward here (same axis as three.js z in the canvas).
  Corners: TL_00 (NW), TL_01 (NE), TL_10 (SW), TL_11 (SE).
  Each corner has two external outward stubs.
-->
<nodes>
    <!-- Controlled intersections (rectangle corners, 100m x 100m) -->
    <node id="TL_00" x="0"   y="0"   type="traffic_light" tl="TL_00"/>
    <node id="TL_01" x="100" y="0"   type="traffic_light" tl="TL_01"/>
    <node id="TL_10" x="0"   y="100" type="traffic_light" tl="TL_10"/>
    <node id="TL_11" x="100" y="100" type="traffic_light" tl="TL_11"/>

    <!-- TL_00 (NW) external stubs: north + west -->
    <node id="EXT_TL00_N" x="0"   y="-50" type="priority"/>
    <node id="EXT_TL00_W" x="-50" y="0"   type="priority"/>

    <!-- TL_01 (NE) external stubs: north + east -->
    <node id="EXT_TL01_N" x="100" y="-50" type="priority"/>
    <node id="EXT_TL01_E" x="150" y="0"   type="priority"/>

    <!-- TL_10 (SW) external stubs: south + west -->
    <node id="EXT_TL10_S" x="0"   y="150" type="priority"/>
    <node id="EXT_TL10_W" x="-50" y="100" type="priority"/>

    <!-- TL_11 (SE) external stubs: south + east -->
    <node id="EXT_TL11_S" x="100" y="150" type="priority"/>
    <node id="EXT_TL11_E" x="150" y="100" type="priority"/>
</nodes>
